# ── LLM (triage brain) ────────────────────────────────────────────────────────
# Default: Claude. Swap to OpenAI with LLM_PROVIDER=openai and LLM_MODEL=gpt-4o.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for embeddings (duplicate detection) even when triage uses Claude.
# Also used when JUDGE_LLM_PROVIDER=openai (default for cross-family judging).
OPENAI_API_KEY=your_openai_api_key_here

# Optional — use OpenAI for triage instead:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# ── LLM-as-Judge (opt-in; ENABLE_LLM_JUDGE=true) ──────────────────────────────
# ENABLE_LLM_JUDGE=false
# JUDGE_LLM_PROVIDER=openai
# JUDGE_LLM_MODEL=gpt-4o-mini

# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_TEAM_ID=T0123456789
SLACK_CHANNEL_ID=C0123456789

# ── Jira ───────────────────────────────────────────────────────────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=DEV

# ── Agent Behaviour ────────────────────────────────────────────────────────────
CONFIDENCE_AUTO_ACT=0.90       # above this → agent acts without asking
CONFIDENCE_ASK_HUMAN=0.65      # below this → agent asks for clarification
